#!/bin/sh

systemctl --global disable t3-krfb-wayland.service >/dev/null 2>&1 || true

if id gemstone >/dev/null 2>&1; then
    for unit in \
        plasma-gmenudbusmenuproxy.service \
        plasma-xembedsniproxy.service \
        app-kaccess@autostart.service \
        at-spi-dbus-bus.service \
        xdg-desktop-portal-gtk.service \
        filter-chain.service
    do
        link="/home/gemstone/.config/systemd/user/${unit}"
        if [ -L "${link}" ] && [ "$(readlink "${link}")" = /dev/null ]; then
            rm -f "${link}"
        fi
    done

    if [ -S /run/user/1000/bus ]; then
        runuser -u gemstone -- env \
            XDG_RUNTIME_DIR=/run/user/1000 \
            DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
            systemctl --user daemon-reload \
            >/dev/null 2>&1 || true
        runuser -u gemstone -- env \
            XDG_RUNTIME_DIR=/run/user/1000 \
            DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
            systemctl --user disable --now t3-krfb-wayland.service \
            >/dev/null 2>&1 || true
    fi
fi

exit 0
